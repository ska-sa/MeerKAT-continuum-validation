<DESCRIPTION>-oc.form=dec
-source=VIII/97
-out.all
-out.max=unlimited</DESCRIPTION>
</PARAM>
<FIELD datatype="int" name="recno" ucd="meta.record" width="8">
<DESCRIPTION>Record number assigned by the VizieR team. Should Not be used for identification.</DESCRIPTION>
<VALUES null='-2147483648'/>
<LINK title="LINK" href="http://vizier.u-strasbg.fr/viz-bin/VizieR-5?-info=XML&amp;-out.add=.&amp;-source=VIII/97/catalog&amp;recno=${recno}"/>
</FIELD>
<FIELD datatype="double" name="RA" unit="degrees">
<DESCRIPTION>FK5 J2000.0 Right Ascension</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="DEC" unit="degrees">
<DESCRIPTION>FK5 J2000.0 Declination</DESCRIPTION>
</FIELD>
<FIELD arraysize="11" datatype="char" name="RAJ2000" ref="J2000" ucd="pos.eq.ra;meta.main" unit="&quot;h:m:s&quot;">
<DESCRIPTION>Right ascension (J2000) (\original{RA2000})</DESCRIPTION>
</FIELD>
<FIELD arraysize="11" datatype="char" name="DEJ2000" ref="J2000" ucd="pos.eq.dec;meta.main" unit="&quot;d:m:s&quot;">
<DESCRIPTION>Declination (J2000) (\original{DEC2000})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="Sp" precision="2" ucd="phot.flux.density;em.radio.20-100MHz" unit="Jy" width="7">
<DESCRIPTION>[0.2/8498] Peak intensity at 74MHz; in Jy/beam (\original{PEAK_INT})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="e_Sp" precision="2" ucd="stat.error;src.spType" unit="Jy" width="5">
<DESCRIPTION>[0.05/7.1] Intensity RMS in Jy/beam (\original{I_RMS})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="MajAx" precision="2" ucd="phys.angSize" unit="deg" width="5">
<DESCRIPTION>[0.02/0.03] Major axis of deconvolved component size (\original{MAJOR_AX})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="MinAx" precision="2" ucd="phys.angSize;src" unit="deg" width="5">
<DESCRIPTION>[0.02/0.03] Minor axis of deconvolved component size (\original{MINOR_AX})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="PA" precision="2" ucd="pos.posAng" unit="deg" width="6">
<DESCRIPTION>[-90/90] Position angle of Major Ax (\original{POSANGLE})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="Rrms" precision="2" ucd="stat.fit.residual" unit="Jy" width="6">
<DESCRIPTION>[0.02/353] Residual RMS, in Jy/beam (\original{RES_RMS})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="Rpk" precision="2" ucd="stat.fit.residual" unit="Jy" width="7">
<DESCRIPTION>[0.05/3824] Residual peak intensity, in Jy/beam (\original{RES_PEAK})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="RFlx" precision="2" ucd="stat.fit.residual" unit="Jy" width="7">
<DESCRIPTION>[-102/105] Residual integrated flux (\original{RES_FLUX})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="Xpos" precision="1" ucd="pos.cartesian.x;instr.det" unit="pix" width="6">
<DESCRIPTION>[332/3745] X position of source on map (\original{CENTER_X})</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="Ypos" precision="1" ucd="pos.cartesian.y;instr.det" unit="pix" width="6">
<DESCRIPTION>[332/3745] Y position of source on map (\original{CENTER_Y})</DESCRIPTION>
</FIELD>
<FIELD arraysize="8" datatype="char" name="Field" ucd="meta.id;meta.main">
<DESCRIPTION>Field designation (HHMM+DDd; J2000) (FIELD) {\em(doesn't match the fields in table1)} \linkRole{FITS image of the field}</DESCRIPTION>
<LINK title="image of field" href="http://www.cv.nrao.edu/vlss/MAPS/${Field}.FITS.gz"/>
</FIELD>
<FIELD datatype="int" name="JD" ucd="time.epoch" unit="d" width="7">
<DESCRIPTION>[2456435] Julian Date field processed (2456435) (\original{JD_PROCESSED})</DESCRIPTION>
<VALUES null='-2147483648'/>
</FIELD>
<FIELD datatype="short" name="VLSS" ucd="meta.ref.url" width="3">
<DESCRIPTION>Cross-match within 75" with the VLSS data (Cat. VIII/79) [NULL integer written as an empty string]</DESCRIPTION>
<VALUES null='-32768'/>
<LINK title="LINK" href="http://vizier.u-strasbg.fr/viz-bin/nph-htx/A?%5cignore%7bX%7d%5cifnum%7b${VLSS}%7d%3e0%5cvMore%7b-source=VIII/79/catalog%5c%26-out.max=999%5c%26-c=${+RAJ2000}${+DEJ2000}&amp;-c.eq=J2000.000%5c%26-c.rs=75%7d%7b${VLSS}%7d%5celse%7b${VLSS}%7d%5cfi"/>
</FIELD>
<FIELD arraysize="3" datatype="char" name="img" ucd="meta.ref.url">
<DESCRIPTION>FITS Image of the target (about 200x200 pixels for a field of view of 17'x17')</DESCRIPTION>
<LINK title="LINK" href="http://www.cv.nrao.edu/cgi-bin/newVLSSpostage.pl?Equinox=J2000&amp;RA=${RAJ2000}&amp;Dec=${DEJ2000}&amp;Size=0.278+0.278&amp;Cells=5.0+5.0&amp;Type=image/jpeg"/>
</FIELD>
<FIELD arraysize="3" datatype="char" name="SED" ucd="meta.ref.url">
<DESCRIPTION>Plot the spectrum with SPECFIND (Vollmer et al. 2009, Cat. VIII/85)</DESCRIPTION>
<LINK title="LINK" href="http://vizier.u-strasbg.fr/viz-bin/nph-htx/A?%5cSPECFIND%7b-c=${+RAJ2000}${+DEJ2000},rs=30%7d%7b-query=asu_sed4%20-source=VIII/97/./catalog%20-c=%5csed%7bs/%20/:/g%7d%7b${+RAJ2000}${+DEJ2000}%7d%20-c.rs=30%7d%7b${SED}%7d"/>
</FIELD>
