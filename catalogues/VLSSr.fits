<TABLE name="VIII/97/catalog" nrows="92965">
<DESCRIPTION>
VLSSr catalog (\originalcolumnnames)
</DESCRIPTION>
<PARAM arraysize="19" datatype="char" name="votable-version" value="1.99+ (14-Oct-2013)"/>
<PARAM arraysize="9" datatype="char" name="-ref" value="VOTx36203"/>
<PARAM arraysize="9" datatype="char" name="-out.max" value="unlimited"/>
